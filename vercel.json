{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/xcelerate.mjs": { "maxDuration": 60 },
    "api/xperts.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
